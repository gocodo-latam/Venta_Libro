# Copia este archivo como variables de entorno en Vercel
# (Project Settings > Environment Variables). NO subas un archivo
# .env con tus claves reales a ningún repositorio público.

# Credenciales de tu comercio en Flow.cl
FLOW_API_KEY=tu_api_key_de_flow
FLOW_SECRET_KEY=tu_secret_key_de_flow

# URL de la Web App de Google Apps Script (ver google-apps-script/Code.gs)
SHEET_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
# El mismo token secreto que pusiste dentro de Code.gs
SHEET_WEBAPP_TOKEN=el_mismo_token_secreto_del_apps_script

# URL pública final de tu sitio ya desplegado en Vercel
# (sin "/" al final), ej: https://preventa-mi-libro.vercel.app
SITE_URL=https://tu-sitio.vercel.app
